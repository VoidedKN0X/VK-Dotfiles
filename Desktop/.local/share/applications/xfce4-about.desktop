[Desktop Entry]
# Hides "About Xfce" (xfce4-about, from libxfce4ui, which Thunar pulls in)
# from the app launcher. This copy in ~/.local/share/applications takes the
# place of the system one; NoDisplay=true keeps it out of launchers and menus.
Type=Application
Name=About Xfce
Comment=Information about the Xfce Desktop Environment
Exec=xfce4-about
Icon=org.xfce.about
Categories=X-XFCE;GTK;Settings;
NoDisplay=true
