[Desktop Entry]
Type=Application
Name=LACT
Comment=Control your graphics cards
GenericName=GPU Control Application
# without the frosted glass: Hyprland doesn't blur behind LACT
# (hypr/scripts/solid-gtk.sh)
Exec=sh -c "~/.config/hypr/scripts/solid-gtk.sh lact gui"
Icon=io.github.ilya_zlobintsev.LACT
Categories=System;
Keywords=AMD;GPU;Radeon;
