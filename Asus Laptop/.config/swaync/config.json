{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-width": 380,
  "control-center-margin-top": 6,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 46,
  "control-center-margin-left": 0,
  "control-center-height": 600,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-window-width": 360,
  "notification-icon-size": 40,
  "notification-body-image-height": 180,
  "notification-body-image-width": 180,
  "timeout": 8,
  "timeout-low": 6,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "title",
    "dnd",
    "mpris",
    "notifications",
    "volume",
    "backlight",
    "buttons-grid"
  ],
  "widget-config": {
    "notifications": {
      "vexpand": true
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "mpris": {
      "autohide": true,
      "show-album-art": "never"
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear all"
    },
    "volume": {
      "label": "󰕾 "
    },
    "backlight": {
      "label": "󰃟 "
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "",
          "command": "~/.config/swaync/scripts/wifi.sh"
        },
        {
          "label": "",
          "command": "~/.config/swaync/scripts/bluetooth.sh"
        },
        {
          "label": "",
          "command": "~/.config/swaync/scripts/power.sh reboot"
        },
        {
          "label": "",
          "command": "~/.config/swaync/scripts/power.sh poweroff"
        }
      ]
    }
  }
}